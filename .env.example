# ============================================================
# NetGuard — Environment Variables Template
# ============================================================
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the values in your NEW .env file
#   3. NEVER commit the .env file — it's in .gitignore
#
# On Railway, set these in:
#   Project → Variables (NOT in a file — Railway reads them directly)
# ============================================================

# ── Flask core ───────────────────────────────────────────────
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# ── Database ──────────────────────────────────────────────────
# Local SQLite (for development — no setup needed):
DATABASE_URL=sqlite:///monitor.db

# PostgreSQL on Railway (Railway auto-sets this when you add a Postgres plugin):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# ── Admin account ─────────────────────────────────────────────
# This password is used when the system seeds the first admin account.
# Change it immediately after first login!
ADMIN_PASSWORD=Admin@1234!

# ── Flask environment ─────────────────────────────────────────
# Use 'development' locally, 'production' on Railway
FLASK_ENV=development

# Enable debug mode ONLY locally. NEVER in production.
FLASK_DEBUG=false

# ── Port ──────────────────────────────────────────────────────
# Railway sets PORT automatically. Only needed for local overrides.
# PORT=5000
